<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/md_theme_dark_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#44FFFFFF" />

    <!-- Title Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="✂️ Custom Crop Image"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Interactive Drag & Crop View Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="320dp"
                app:cardBackgroundColor="#1A1F2B"
                app:cardCornerRadius="12dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <io.greycode.streamer.views.DragCropView
                    android:id="@+id/dragCropView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Aspect Ratio Preset Chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Aspect Ratio Presets"
                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAspectRatio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatioFree"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Free / Custom Sliders" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatioSquare"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1:1 Square" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio169"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16:9 Landscape" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio43"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:3 Standard" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio916"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9:16 Portrait" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Custom Sliders Section -->
            <LinearLayout
                android:id="@+id/layoutSlidersSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crop Left %"
                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderCropLeft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.01"
                    android:value="0.0"
                    android:valueFrom="0.0"
                    android:valueTo="0.45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crop Right %"
                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderCropRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.01"
                    android:value="0.0"
                    android:valueFrom="0.0"
                    android:valueTo="0.45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crop Top %"
                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderCropTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.01"
                    android:value="0.0"
                    android:valueFrom="0.0"
                    android:valueTo="0.45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crop Bottom %"
                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderCropBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.01"
                    android:value="0.0"
                    android:valueFrom="0.0"
                    android:valueTo="0.45" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoveBgInCrop"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🪄 Make Background Transparent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelCrop"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Cancel" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyCrop"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1.5"
                        android:text="💾 Apply &amp; Save to App Dir"
                        app:icon="@drawable/ic_check" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
